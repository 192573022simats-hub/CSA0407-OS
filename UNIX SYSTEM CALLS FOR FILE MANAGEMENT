#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd;
    char text[] = "Hello Operating System";
    char buffer[50];

    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);

    if(fd < 0) {
        printf("File cannot be opened.\n");
        return 1;
    }

    write(fd, text, sizeof(text));

    lseek(fd, 0, SEEK_SET);

    read(fd, buffer, sizeof(text));

    printf("Data from file: %s\n", buffer);

    close(fd);

    return 0;
}
