#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i, head, size, total = 0;
    int a[50];

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter requests: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &size);

    // Simple C-SCAN movement
    for(i = 0; i < n; i++) {
        if(a[i] >= head) {
            total += abs(head - a[i]);
            head = a[i];
        }
    }

    total += abs(head - (size - 1));
    head = 0;

    for(i = 0; i < n; i++) {
        if(a[i] < head) {
            total += abs(head - a[i]);
            head = a[i];
        }
    }

    printf("Total Head Movement = %d\n", total);
    return 0;
}
