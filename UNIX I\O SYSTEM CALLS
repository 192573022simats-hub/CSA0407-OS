#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd;
    struct stat st;
    DIR *dir;
    struct dirent *entry;

    fd = open("test.txt", O_RDWR | O_CREAT, 0644);

    if(fd < 0) {
        printf("File opening failed\n");
        return 1;
    }

    printf("File opened successfully\n");

    lseek(fd, 0, SEEK_END);
    printf("File pointer moved\n");

    fcntl(fd, F_GETFL);
    printf("fcntl executed\n");

    stat("test.txt", &st);
    printf("File size = %ld bytes\n", st.st_size);

    dir = opendir(".");
    printf("Directory contents:\n");

    while((entry = readdir(dir)) != NULL)
        printf("%s\n", entry->d_name);

    closedir(dir);
    close(fd);

    return 0;
}
