#include <stdio.h>
int main()
{
    int pages[20], frame[10];
    int n, f, i, j, k, pos, farthest, found, faults = 0;
    printf("Enter number of pages: ");
    scanf("%d", &n);
    printf("Enter reference string: ");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);
    printf("Enter number of frames: ");
    scanf("%d", &f);
    for(i = 0; i < f; i++)
        frame[i] = -1;
    for(i = 0; i < n; i++)
    {
        found = 0;
        for(j = 0; j < f; j++)
        {
            if(frame[j] == pages[i])
                found = 1;
        }
        if(found == 0)
        {
            pos = -1;
            farthest = i;
            for(j = 0; j < f; j++)
            {
                for(k = i + 1; k < n; k++)
                {
                    if(frame[j] == pages[k])
                        break;
                }
                if(k > farthest)
                {
                    farthest = k;
                    pos = j;
                }
            }
            if(pos == -1)
            {
                for(j = 0; j < f; j++)
                {
                    if(frame[j] == -1)
                    {
                        pos = j;
                        break;
                    }
                }
            }
            frame[pos] = pages[i];
            faults++;
        }
    }
    printf("Number of Page Faults = %d\n", faults);
    return 0;
}
