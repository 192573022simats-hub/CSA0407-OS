#include <stdio.h>
int main()
{
    int index[10], n, i;
    printf("Enter number of file blocks: ");
    scanf("%d", &n);
    printf("Enter block numbers: ");
    for(i = 0; i < n; i++)
        scanf("%d", &index[i]);
    printf("Index Block contains: ");
    for(i = 0; i < n; i++)
        printf("%d ", index[i]);
    printf("\nFile Blocks: ");
    for(i = 0; i < n; i++)
        printf("%d ", index[i]);
    return 0;
}
