#include <stdio.h>
int main()
{
    int pages[20], frame[10], time[10];
    int n, f, i, j, pos, found, faults = 0;
    printf("Enter number of pages: ");
    scanf("%d", &n);
    printf("Enter reference string: ");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);
    printf("Enter number of frames: ");
    scanf("%d", &f);
    for(i = 0; i < f; i++)
    {
        frame[i] = -1;
        time[i] = 0;
    }
    for(i = 0; i < n; i++)
    {
        found = 0;
        for(j = 0; j < f; j++)
        {
            if(frame[j] == pages[i])
            {
                found = 1;
                time[j] = i;
            }
        }
        if(found == 0)
        {
            pos = 0;
            for(j = 1; j < f; j++)
            {
                if(time[j] < time[pos])
                    pos = j;
            }
            frame[pos] = pages[i];
            time[pos] = i;
            faults++;
        }
    }
    printf("Number of Page Faults = %d\n", faults);
    return 0;
}
